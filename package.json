{
  "name": "timeline-todo",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/shared/src/db.ts",
    "demo": "node scripts/demo.mjs && cd apps/web && ALLOWED_EMAIL=demo@example.com NEXT_PUBLIC_DEMO=1 pnpm dev"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "supabase": "^2.40.0",
    "turbo": "^2.5.0",
    "typescript": "^5.6.3"
  }
}
