# Supabase (local values print from `pnpm db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth client (Web application). Authorized redirect URIs:
#   http://127.0.0.1:54321/auth/v1/callback   (Supabase sign-in)
#   http://localhost:3000/api/google/callback (Calendar connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APP_URL=http://localhost:3000
# Public HTTPS URL for gcal push notifications (e.g. a cloudflared tunnel). Leave unset to poll only.
GOOGLE_WEBHOOK_BASE_URL=

# Only this Google account can sign in.
ALLOWED_EMAIL=

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
CRON_SECRET=
